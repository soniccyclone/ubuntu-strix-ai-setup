{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["/home/nathan/.claude/tropes.md"],
  
  "provider": {
    "contract": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kairic contract (local)",
      "options": { "baseURL": "http://127.0.0.1:8080/v1" },
      "models": {
        "code": {
          "name": "Qwen3.8-27B IU4 Kairic Edge",
          "tool_call": true,
          "reasoning": true,
          "attachment": false,
          "limit": { "context": 131072, "output": 32768 },
          "options": { "id_slot": 0 }
        },
        "code-sub": {
          "id": "code",
          "name": "[internal] subagent lane - not for chat",
          "tool_call": true,
          "reasoning": true,
          "attachment": false,
          "limit": { "context": 131072, "output": 16384 },
          "options": { "id_slot": 1 }
        },
        "compact": {
          "name": "[internal] compaction worker - not for chat",
          "tool_call": false,
          "reasoning": false,
          "attachment": false,
          "limit": { "context": 262144, "output": 8192 }
        }
      }
    }
  },

  "model": "contract/code",
  "small_model": "contract/compact",

  "agent": {
    "general":    { "model": "contract/code-sub" },
    "explore":    { "model": "contract/code-sub" },
    "compaction": { "model": "contract/compact" },
    "title":      { "model": "contract/compact" },
    "summary":    { "model": "contract/compact" }
  },

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 24576
  },

  "lsp": true
}
