[Unit]
Description=llama-swap — the serving contract
Documentation=file:///home/nathan/code-stuff/ubuntu-strix-ai-setup/config/llama-swap.yaml
After=network.target

[Service]
Type=simple
# Loopback ONLY. A socket bound here cannot receive a packet addressed to a
# routable interface, which is why this project needs no firewall rule.
ExecStart=%h/.local/opt/llama-swap/llama-swap \
  -config %h/code-stuff/ubuntu-strix-ai-setup/config/llama-swap.yaml \
  -listen 127.0.0.1:8080 \
  -watch-config
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
