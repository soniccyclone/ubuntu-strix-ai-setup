# ROCmFPX engine, HIP build, for gfx1151.
#
# Built on NOBLE, not on the host's 26.04, and that is the whole point:
#
#   * AMD publishes ROCm for noble. 26.04 has no AMD suite at all
#     (repo.radeon.com/rocm/apt/latest/dists/ has jammy and noble only).
#   * On 26.04 the distro's own ROCm packaging collides with AMD's: Ubuntu
#     numbers rocm-cmake 7.1.1 while AMD numbers it 0.14.0, so apt prefers the
#     distro's and AMD's exact-version dependencies can never resolve. Fixing
#     that needs a priority>1000 pin to force downgrades across ~24 packages.
#   * ROCm's lld links against libxml2.so.2 and libicuuc.so.74, which noble has
#     and 26.04 does not, so a host install also needs .so files hand-copied out
#     of noble .debs into /opt/rocm-7.2.2/lib.
#
# None of that applies inside a noble container. Nathan's suggestion, and it is
# the right one: build and run where the toolchain is supported, and give the
# container the GPU. Cycle 2 already proved rootless podman reaches gfx1151
# unprivileged with --device=/dev/kfd --device=/dev/dri --group-add keep-groups.
FROM docker.io/library/ubuntu:24.04

ARG ROCM_VER=7.2.2
ARG PINNED_COMMIT=0fc9568e07ccc8553010864cb8db1957e629cbfa
ARG REPO=https://github.com/charlie12345/ROCmFPX.git

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl gnupg build-essential cmake git ninja-build \
      pkg-config libssl-dev python3 \
 && curl -fsSL https://repo.radeon.com/rocm/rocm.gpg.key \
      | gpg --dearmor -o /usr/share/keyrings/rocm.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/rocm.gpg] \
https://repo.radeon.com/rocm/apt/${ROCM_VER} noble main" > /etc/apt/sources.list.d/rocm.list \
 # Even on noble, universe carries its own hipcc (5.7.1-3) which collides with
 # AMD's (1.1.1.70202). Pinning AMD's origin above everything resolves it.
 # This is safe HERE precisely because it is a throwaway container -- the same
 # pin on the host would have downgraded ~24 system packages, which is why we
 # are not doing this on the host.
 && printf 'Package: *\nPin: origin repo.radeon.com\nPin-Priority: 1001\n' \
      > /etc/apt/preferences.d/rocm-amd \
 && apt-get update \
 && apt-get install -y --no-install-recommends rocm-hip-sdk rocwmma-dev \
 && rm -rf /var/lib/apt/lists/*

ENV ROCM_PATH=/opt/rocm
ENV PATH=/opt/rocm/bin:$PATH

RUN git clone --filter=blob:none "$REPO" /src \
 && git -C /src checkout --detach "$PINNED_COMMIT"

# HIPCXX from hipconfig, not the distro clang. Pointing CMAKE_HIP_COMPILER at
# Ubuntu's clang-21 produced 308 errors -- unresolved device math builtins
# (fabsf, fmaxf, powf) -- because it has no ROCm device-math implementation.
# Flags follow nabe2030/hip-vs-vulkan-evo-x2, measured on this same silicon:
# ROCWMMA_FATTN is OFF because their flash-attention path is slower on gfx1151,
# NO_VMM avoids a startup crash, MMQ_MFMA helps quantised models.
RUN export HIPCXX="$(hipconfig -l)/clang" HIP_PATH="$(hipconfig -R)" \
 && cmake -S /src -B /build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DGGML_HIP=ON -DGGML_VULKAN=OFF -DGGML_CUDA=OFF \
      -DGPU_TARGETS=gfx1151 -DAMDGPU_TARGETS=gfx1151 \
      -DGGML_HIP_ROCWMMA_FATTN=OFF \
      -DGGML_HIP_NO_VMM=ON \
      -DGGML_HIP_MMQ_MFMA=ON \
      -DGGML_NATIVE=ON \
      -DLLAMA_BUILD_WEBUI=OFF -DGGML_BUILD_TESTS=OFF -DLLAMA_BUILD_TESTS=OFF \
 && cmake --build /build --target llama-bench llama-server llama-cli -j"$(nproc)" \
 && mkdir -p /engine \
 # Their recommended config is BUILD_SHARED_LIBS=ON, so the binaries need the
 # .so files beside them. Copying only the executables produced
 #   error while loading shared libraries: libllama-common.so.0
 && cp /build/bin/llama-bench /build/bin/llama-server /build/bin/llama-cli /engine/ \
 # cp -a preserves soname symlinks. `-type f -exec cp` copied only the
 # versioned files (libllama-common.so.0.0.244) and dropped the symlink the
 # loader actually resolves (libllama-common.so.0), so the binary still
 # failed at run time long after the build reported success.
 && cp -a /build/bin/*.so* /engine/ \
 && rm -rf /build /src

ENV LD_LIBRARY_PATH=/engine:/opt/rocm/lib
VOLUME /models
WORKDIR /engine
ENTRYPOINT ["/engine/llama-bench"]
